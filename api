// api/index.js - Telegram Bot API Webhook
// github.com/Sofior12/li/api

export default async function handler(req, res) {
    // CORS headers
    res.setHeader('Access-Control-Allow-Origin', '*');
    res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
    res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

    if (req.method === 'OPTIONS') {
        return res.status(200).end();
    }

    // Configuration
    const BOT_TOKEN = process.env.TELEGRAM_BOT_TOKEN || '7700000000:AAE-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx';
    const CHAT_ID = process.env.TELEGRAM_CHAT_ID || '123456789';

    // Handle GET request (health check)
    if (req.method === 'GET') {
        return res.status(200).json({
            status: 'ok',
            message: 'Telegram Bot API Webhook is running',
            repo: 'github.com/Sofior12/li',
            endpoints: {
                'POST /api/send': 'Send message to Telegram',
                'GET /api': 'Health check'
            }
        });
    }

    // Handle POST request (send notification)
    if (req.method === 'POST') {
        try {
            const { message, parse_mode = 'HTML', chat_id } = req.body;

            if (!message) {
                return res.status(400).json({
                    ok: false,
                    error: 'Message is required'
                });
            }

            const targetChatId = chat_id || CHAT_ID;

            // Send to Telegram
            const url = `https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`;
            const payload = {
                chat_id: targetChatId,
                text: message,
                parse_mode: parse_mode,
                disable_web_page_preview: true,
            };

            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });

            const data = await response.json();

            if (data.ok) {
                return res.status(200).json({
                    ok: true,
                    result: data.result,
                    repo: 'github.com/Sofior12/li'
                });
            } else {
                return res.status(400).json({
                    ok: false,
                    error: data.description || 'Telegram API error',
                    repo: 'github.com/Sofior12/li'
                });
            }

        } catch (error) {
            return res.status(500).json({
                ok: false,
                error: error.message,
                repo: 'github.com/Sofior12/li'
            });
        }
    }

    // Method not allowed
    return res.status(405).json({
        ok: false,
        error: 'Method not allowed',
        repo: 'github.com/Sofior12/li'
    });
}
